PORT=3000
NODE_ENV=development
NOTION_API_KEY=your_notion_api_key_here
NOTION_ORDERS_DATABASE_ID=your_notion_database_id_here
NOTION_CONTACT_DATABASE_ID=your_notion_contact_database_id_here
NOTION_INVENTORY_DATABASE_ID=your_notion_inventory_database_id_here
NOTION_SHOP_ORDERS_DATABASE_ID=your_notion_shop_orders_database_id_here
# REQUIRED: the "Product Categories" database — the shop's sole source for the
# category list, chip order, and which categories show the size guide. Each row is
# a category: "Name" (label), "Show size guide" (checkbox), and "Sort" (number,
# chip order). Inventory rows point at a category via a "Category" relation, so the
# category + sized flag follow the linked page (renames propagate with no
# redeploy). Share the Notion integration with it. Unset ⇒ GET /api/products fails
# (there is no fallback), so the shop needs this set.
NOTION_PRODUCT_CATEGORIES_DATABASE_ID=your_notion_product_categories_database_id_here
# The "📅 Production Schedule" database. A scheduled reconciliation writes one
# per-stage milestone row here for each order that has a "Due Date" set. Share the
# Notion integration with this database, and add a "Stage" (select) + "Order"
# (relation -> Order Tracking Pipeline) property to it (see CLAUDE.md).
NOTION_PRODUCTION_SCHEDULE_DATABASE_ID=your_notion_production_schedule_database_id_here

# ****** guarding the milestone-reconciliation cron endpoint
# (GET /api/cron/generate-milestones). On Vercel, set this and Vercel Cron sends
# it automatically as "Authorization: ******". Locally, pass the same
# header when calling the endpoint by hand. Unset ⇒ the endpoint returns 401.
CRON_SECRET=your_cron_secret_here
# The same secret also guards the order status-change email webhook
# (POST /api/webhooks/notion-stage-change) — via an "Authorization: Bearer
# <CRON_SECRET>" header (preferred, on the Notion automation) or a ?secret= query
# token, which is now the ONLY place the app reads this secret from a URL.
# Everything the atelier used to trigger by opening a ?secret= link — the milestone
# button, the invoice generator, the per-order status-update link, both refund
# links — moved to the signed-in studio dashboard (POST /api/studio/tools/:tool,
# gated by STUDIO_STAFF_EMAILS below), so this secret is now sent only as a header,
# only by Vercel Cron and the Notion automation. Rotate it after deploying that
# change: it has been sitting in Notion formula properties and browser history.
# Order status-change emails add NO new env vars: they send
# from RESEND_FROM_EMAIL (the orders@ sender) and link to PUBLIC_BASE_URL/track.
# One-time setup is in Notion, not here: a database automation ("when Stage
# changes → send webhook") plus a "Last Notified Stage" (rich_text) property on
# the Order Tracking Pipeline that gates emails to forward movement (the app
# writes it; leave it empty). See CLAUDE.md → "Order status-change emails".


# Optional: the "Client CRM" database. When set, each new custom order upserts a
# client record here (deduped by email) and links the order to it. Unset ⇒ CRM
# linking is skipped and orders behave exactly as before.
NOTION_CLIENT_CRM_DATABASE_ID=your_notion_client_crm_database_id_here

# Optional: the intake color palette for the custom-order form's color picker
# (GET /api/colors). A single comma-separated list of "Name #hex" entries, e.g.
# "Emerald #0B6E4F, Rose Gold #C5878C, Navy #1F2A44". Unset ⇒ a built-in primary
# palette (Red, Orange, Yellow, …) is used, so the picker always works. Better set
# from the "Studio Settings" Notion database (a COLOR_PALETTE row) so it's editable
# without a redeploy — this env var is the fallback. The picks are written back to
# the order's "Colors" (multi_select) + "Color Usage" (rich_text) properties, which
# you must add to the Order Tracking Pipeline database. See CLAUDE.md → "Color
# selector (intake)".
# COLOR_PALETTE="Emerald #0B6E4F, Rose Gold #C5878C, Navy #1F2A44"

# Custom-order payments. The order's "invoices & payments" record is the source
# of truth for all three staged payments — first deposit, second deposit, and the
# final balance (itemized materials + labor from "Invoice Line Items", minus the
# deposits paid). The app READS both databases and collects each stage via Stripe.
# Share the Notion integration with BOTH databases or reads 404. Deposits are
# payable once the atelier sets their amount; the itemized balance appears once
# the atelier ticks "Invoice Ready" on the invoice.
NOTION_INVOICES_DATABASE_ID=your_notion_invoices_database_id_here
NOTION_INVOICE_LINE_ITEMS_DATABASE_ID=your_notion_invoice_line_items_database_id_here
# The costing system the invoice line-item generator reads to itemize a custom
# order — run from the studio dashboard's "Itemize an invoice" tool. Share the
# Notion integration with both "costing (custom orders)" and the "material usage
# database".
NOTION_COSTING_DATABASE_ID=your_notion_costing_database_id_here
NOTION_MATERIAL_USAGE_DATABASE_ID=your_notion_material_usage_database_id_here

# The "Reviews" database that holds customers' post-delivery reviews (rating,
# testimonial, and photos of the finished piece) — the raw material for
# testimonials and the portfolio. A customer can leave a review from the
# tracking page once their order reaches its final (delivered) stage
# (POST /api/orders/:n/reviews). Create the database with these properties and
# share the Notion integration with it:
#   Title (title), Rating (number), Review (rich_text),
#   Customer Name (rich_text), Order Number (rich_text), Email (email),
#   Consent to Publish (checkbox), Email Verified (checkbox),
#   Status (select, e.g. New / Published), and optionally a
#   Client (relation -> Client CRM). Fresh reviews land with Status "New" for
# the atelier to curate; setting Status to exactly "Published" on a review whose
# "Consent to Publish" box is ticked is what puts it on the home and about pages
# (GET /api/reviews). Both are required, and the option name is matched
# literally. Unset ⇒ the review endpoint errors and the testimonial strip is
# simply absent, so set this to turn the feature on.
NOTION_REVIEWS_DATABASE_ID=your_notion_reviews_database_id_here

# Appointment scheduling runs on Google Calendar for conflicts: availability is
# each staff member's calendar free/busy subtracted from the standing working
# hours below, and each booking is written as a calendar event that invites the
# customer (and creates a Google Meet link for virtual).
#
# GOOGLE_SERVICE_ACCOUNT_KEY: the full JSON of a Google Cloud service-account
# key (enable the Google Calendar API). For it to act
# as each staff member — read free/busy, write events, invite the customer —
# authorize its client id for scope https://www.googleapis.com/auth/calendar
# under Google Workspace Admin → Security → API controls → Domain-wide
# delegation. Paste the JSON on one line (Vercel accepts multi-line too).
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}

# The standing working hours — the "when are we open" grid Google free/busy
# can't provide — are the `staff_availability` Postgres table, edited on the
# studio dashboard (/studio → Working hours). They need no variable of their
# own: they ride POSTGRES_URL below. Required for appointment booking, with no
# fallback — see CLAUDE.md → "Staff availability, edited on the dashboard".
# (This replaced a Google Sheet, then a Notion database; both are retired.)

# Resend — customer notification emails (order confirmation, contact
# acknowledgement, back-in-stock request confirmation). RESEND_FROM_EMAIL must
# use a domain verified in the Resend dashboard, e.g. "A.A Atelier <orders@a3iceanddance.com>".
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=A.A Atelier <orders@a3iceanddance.com>

# Optional: the atelier's own inbox. When set, each new order / contact message /
# back-in-stock request also sends an internal notification here (Reply-To the
# customer), so the team gets an email nudge in addition to the Notion row.
# Leave unset to skip these internal notifications.
ATELIER_INBOX_EMAIL=orders@a3iceanddance.com

# Optional: per-function overrides for contact-form mail. Order/shop/back-in-stock
# mail uses RESEND_FROM_EMAIL + ATELIER_INBOX_EMAIL above; contact-form mail uses
# these when set, else falls back to those base vars. Set them to send/receive
# contact mail from a separate address (e.g. hello@) — same verified domain, no
# extra Resend setup.
RESEND_CONTACT_FROM_EMAIL=A.A Atelier <hello@a3iceanddance.com>
ATELIER_CONTACT_INBOX_EMAIL=hello@a3iceanddance.com

# Optional: per-function overrides for appointment-booking mail. Falls back to
# the base RESEND_FROM_EMAIL / ATELIER_INBOX_EMAIL when unset.
RESEND_APPOINTMENTS_FROM_EMAIL=A.A Atelier <appointments@a3iceanddance.com>
ATELIER_APPOINTMENTS_INBOX_EMAIL=appointments@a3iceanddance.com

# Optional: Resend Marketing Audience id for the newsletter/mailing list. When
# set, each newsletter opt-in is also synced into this Resend Audience (the
# sending list + unsubscribe authority); campaigns are then composed and sent as
# Resend *Broadcasts* from the Resend dashboard, which attach the one-click
# unsubscribe automatically. Unset ⇒ the audience sync is skipped and the opt-in
# is still captured in Notion. Create the audience in Resend → Audiences and copy
# its id here. Free up to 1,000 contacts.
RESEND_AUDIENCE_ID=your_resend_audience_id_here

# Appointment booking policy (all optional — sensible defaults shown).
# APPOINTMENT_TIMEZONE is the IANA zone the atelier's working hours and offered
# slot times are expressed in. Lead/advance bound how soon and how far out a
# customer can book; the step is the grid slots snap to within working hours.
APPOINTMENT_TIMEZONE=America/Chicago
APPOINTMENT_MIN_LEAD_HOURS=24
APPOINTMENT_MAX_ADVANCE_DAYS=45
APPOINTMENT_SLOT_STEP_MINUTES=15
# How many local days ahead the day-before reminder sweep looks (default 1).
# A value below 1 falls back to the default rather than becoming a morning-of note.
APPOINTMENT_REMINDER_LEAD_DAYS=1

# Stripe (shop checkout). Use test-mode keys locally.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# From `stripe listen` locally, or the webhook endpoint's signing secret on Vercel.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# The site origin Stripe redirects back to after checkout (the Vite dev server
# locally). Also the origin Supabase Auth redirects back to after sign-in (add
# PUBLIC_BASE_URL/account/callback to the Supabase redirect allow-list) and the
# origin the appointment "manage" links point back at.
PUBLIC_BASE_URL=http://localhost:5173
# Optional: comma-separated Stripe Shipping Rate ids (shr_...) to offer at shop
# checkout (create + price them under Shipping → Shipping rates in the Stripe
# Dashboard). Unset = no shipping charged, so shipping simply won't appear at
# checkout until this is set. Two gotchas: the ids must be created in the SAME
# mode as STRIPE_SECRET_KEY (a test-mode shr_ won't work with a live key, and
# vice-versa), and the rate's currency must be USD to match the session. Use
# your test-mode ids here; on Vercel, Production gets your live ids and
# Preview/Development get the test ids (see the deployment note in CLAUDE.md).
STRIPE_SHIPPING_RATE_IDS=
# Optional: comma-separated buy-now-pay-later methods to offer at checkout, from
# klarna, affirm, afterpay_clearpay (Afterpay/Clearpay share one id). Enable each
# one in the Stripe Dashboard (Settings → Payment methods) too. Applies to the
# shop cart and the custom-order final balance (deposits stay card-only). Stripe
# pays the studio in full up front and carries the installment risk. Unset = the
# session's payment methods stay dynamic (Dashboard-managed), unchanged. Setting
# this PINS the list to card + these methods (so other dynamic methods like Link
# won't appear on those sessions), and the ids are mode-scoped like the shipping
# rates above. Stripe hides an ineligible method (currency/country/amount) itself.
STRIPE_BNPL_METHODS=

# Customer account portal (Supabase Auth). Sign-in runs on Supabase Auth
# (email+password, Google, and magic link); the browser holds the session and
# sends the Supabase access token as a Bearer credential, which the server
# verifies. REQUIRED for the portal: unset ⇒ sign-in is unavailable and
# GET /api/account/overview responds 401. The frontend reads its own
# VITE_PUBLIC_SUPABASE_* pair (below). No new database of our own — the dashboard
# still reads the customer's existing orders/shop orders by their email.
#
# On Vercel these are provided by the Supabase integration (which also sets
# SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET, and the POSTGRES_* vars below).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Postgres. The app reads the POOLED url at runtime with
# { prepare:false, max:1, idle_timeout:20 } (Supabase PgBouncer, transaction mode).
# It backs Stripe-payment idempotency (processed_payments), the account-portal
# order/client discovery index (clients/order_index, written best-effort on
# order/checkout and read by the overview), the back-in-stock sent-markers
# (restock_alerts), and the studio's standing working hours (staff_availability).
# The first two degrade when unset (Stripe dedup falls back to Notion, the portal
# reads Notion directly); the last two do NOT — with no url there are no working
# hours, so appointment booking offers no slots, and the restock sweep no-ops.
# Run `pnpm --filter @workspace/api-server db:migrate` once to create the tables.
# On Vercel the Supabase integration provides it.
POSTGRES_URL=postgres://user:pass@host:6543/postgres?sslmode=require
# Direct (non-pooled) connection — migrations + the backfill script ONLY (DDL can't
# traverse PgBouncer). Never read by the running app. Used by `pnpm db:migrate`.
POSTGRES_URL_NON_POOLING=postgres://user:pass@host:5432/postgres?sslmode=require

# Frontend build-time copy of the Supabase config. Named VITE_PUBLIC_* to match
# the Supabase→Vercel integration (Vite exposes it because it starts with VITE_);
# a plain VITE_SUPABASE_* pair also works for a simple local .env. Same values as
# SUPABASE_URL / SUPABASE_ANON_KEY above — the anon key is a public client key by
# design, safe to ship to the browser (never the service-role key or JWT secret).
VITE_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Signs the "manage your appointment" links in confirmation emails (the reschedule/
# cancel tokens) — a long random string (e.g. `openssl rand -hex 32`). This is the
# ONLY thing SESSION_SECRET still does now that sign-in moved to Supabase Auth.
# Unset ⇒ those manage links are omitted and the email falls back to "reply to us".
# The link also needs PUBLIC_BASE_URL (above) to be an absolute origin.
SESSION_SECRET=your_session_secret_here

# Optional. The Stage at (and after) which a customer can no longer request a
# measurement change because the garment is in production. Defaults to
# "Cutting/Pinning". Set this if that Stage is named differently in Notion.
# MEASUREMENT_LOCK_FROM_STAGE=Cutting/Pinning

# Optional. Automated fitting reminders. The nightly milestone cron emails a
# customer to book/confirm their fitting when their auto-generated "Fitting"
# production milestone is due within FITTING_REMINDER_LEAD_DAYS. The email links to
# PUBLIC_BASE_URL/appointments?type=fitting (omitted when PUBLIC_BASE_URL is unset).
# FITTING_REMINDER_STAGES names the live Stage option(s) that call for a fitting
# (comma-separated; defaults to "Fitting" — set it if that Stage is named
# differently, or list more than one). FITTING_REMINDER_LEAD_DAYS defaults to 10.
# One-time setup: add a "Reminder Sent" checkbox to the Production Schedule Notion
# database (the app flips it so a reminder is never re-sent).
# FITTING_REMINDER_STAGES=Fitting
# FITTING_REMINDER_LEAD_DAYS=10

# Optional. Payment & deposit due reminders. The same nightly milestone cron emails
# the customer when a deposit or the final balance is coming due — or is overdue —
# using the due dates on the order's invoice. A stage is reminded once, when its due
# date falls on or before today + PAYMENT_REMINDER_LEAD_DAYS (which naturally covers
# already-overdue stages). The email links to PUBLIC_BASE_URL/track?orderNumber=…
# (omitted when PUBLIC_BASE_URL is unset). PAYMENT_REMINDER_LEAD_DAYS defaults to 7.
# One-time setup on the "invoices & payments" Notion database: add the per-stage due
# dates "First Deposit Due" / "Second Deposit Due" (date) — the balance reuses the
# existing "Payment Deadline" — and three "Reminded" checkboxes "First Deposit
# Reminded" / "Second Deposit Reminded" / "Balance Reminded" (the app flips them so a
# reminder is never re-sent). Until those properties exist the reminder pass is a
# no-op. No new env var is required.
# PAYMENT_REMINDER_LEAD_DAYS=7

# Optional. Where production error alerts are emailed. When the app hits an
# error-level condition it would otherwise only log — an unhandled 500, a failed
# Stripe-webhook record, a failed milestone cron, or a customer email Resend
# rejects — services/alert.service.ts emails a heads-up here (see CLAUDE.md).
# Defaults to alexandra@a3iceanddance.com. Requires RESEND_API_KEY +
# RESEND_FROM_EMAIL to be set; unset mailer ⇒ alerts are skipped (the log stands).
# ALERT_INBOX_EMAIL=alexandra@a3iceanddance.com

# Optional. The "Studio Settings" Notion database — a key/value table that lets
# the atelier retune runtime business tunables in Notion instead of editing these
# env vars + redeploying. When set (and the integration is shared with it), these
# settings resolve Notion → this env var → built-in default: RUSH_SURCHARGE_RATE,
# MEASUREMENT_LOCK_FROM_STAGE, APPOINTMENT_TIMEZONE / _MIN_LEAD_HOURS /
# _MAX_ADVANCE_DAYS / _SLOT_STEP_MINUTES / _REMINDER_LEAD_DAYS, COLOR_PALETTE,
# and the notification
# inboxes (ATELIER_INBOX_EMAIL, ATELIER_CONTACT_INBOX_EMAIL,
# ATELIER_APPOINTMENTS_INBOX_EMAIL, ALERT_INBOX_EMAIL). Secrets, database ids, and
# email SENDERS deliberately stay
# here in the environment. Unset ⇒ env-only, exactly as before (see CLAUDE.md,
# "Studio Settings"). Each Notion row: a "Setting" title matching the var name, a
# "Value", and a "Description".
# NOTION_SETTINGS_DATABASE_ID=your_notion_studio_settings_database_id_here

# Optional. Anti-spam timing threshold (milliseconds) for the public submission
# forms (contact, back-in-stock notify, newsletter). A submission completed in
# less time than this is treated as an automated bot and silently dropped (no
# Notion write, no email). Defaults to 2000. Set to 0 to disable the timing check
# (the hidden-honeypot check still applies). These forms also carry a per-IP
# submission rate limit; both are invisible to real visitors. See CLAUDE.md,
# "Invisible anti-spam".
# SPAM_MIN_FILL_MS=2000

# Optional. The studio staff allowlist for the internal, auth-gated surfaces —
# today the studio analytics dashboard at /studio. A comma-separated list of the
# email addresses that may sign in and reach it; staff use the same Supabase Auth
# sign-in as customers, and this promotes their address to studio access.
# FAILS CLOSED: unset or empty ⇒ nobody is staff and /studio 403s for everyone,
# so the dashboard is inert until you configure it. Matching is case-insensitive.
# Deliberately env-only and NOT a Studio Settings key — it's access control, not a
# business tunable, so it doesn't belong in a Notion table anyone can edit.
# Prefer addresses that AREN'T published on the site — the entry doesn't have to
# be the studio's contact address, and a private one is one less thing an
# attacker knows to aim at. It also gates the dashboard's internal tools —
# milestone reconciliation, invoice itemization, the status-update email, and the
# two refunds — which is what let the ?secret= links above be retired. See
# CLAUDE.md, "Studio analytics dashboard" + "Internal tools on the studio dashboard".
# STUDIO_STAFF_EMAILS=alexandra@a3iceanddance.com,alayna@a3iceanddance.com

# Optional. Whether a studio session must have been established with GOOGLE —
# not just belong to an allowlisted address. DEFAULTS TO ON, so you don't have
# to set it: a leaked password or an intercepted magic link then can't reach
# /studio, and the real second factor is 2-step verification enforced on those
# accounts in Google Workspace admin. Requires Google sign-in to be enabled in
# Supabase Auth. Set to false/0/no/off to accept any sign-in method — the
# recovery hatch if Google sign-in is ever unavailable, not a normal setting.
# STUDIO_REQUIRE_GOOGLE=false
# Optional. FRONTEND BUILD-TIME. The Pinterest domain-claim token for
# a3iceanddance.com, from Pinterest → Settings → Claimed accounts → Claim website
# → "Add HTML tag" (copy only the content="..." value, not the whole tag).
# Claiming the domain attributes every Pin saved from the site back to the studio
# account — the logo appears on the Pin — and unlocks Pinterest's analytics for
# saves and outbound clicks. The token is public by design, which is why it is an
# ordinary env var rather than a secret; it is read by a Vite plugin at build time
# and injected into every prerendered page, so it never reaches the client bundle
# (hence no VITE_ prefix). Unset ⇒ no tag is emitted at all. Changing it needs a
# redeploy. See CLAUDE.md, "Social share metadata".
# PINTEREST_DOMAIN_VERIFY=your_pinterest_domain_verify_token_here

# Optional. Enables the Notion *relation* writes that link a customer request or
# a shop order back to the row it concerns: Order / Shop Order on Website Contact
# Messages, Order on Reviews, and Inventory Items on shop orders. Gated because
# the app writes to EXISTING properties — writing a relation property that does
# not exist yet 400s the whole page-create — so add the relations in Notion FIRST,
# then set this. Truthy values: 1 / true / yes (case-insensitive). Unset ⇒ no
# relation is written and the row still names the order in free text, exactly as
# before. See CLAUDE.md, "Relate requests & orders to their sources".
# NOTION_RELATION_LINKS=1

# Optional. Referral & returning-skater reward amounts, all delivered as Stripe
# promotion codes and all also retunable live from the Studio Settings Notion
# database (Notion → env → default). REFERRAL_CREDIT_AMOUNT is the referrer's
# credit in whole dollars; the two PERCENT vars are whole-number percentages
# (0–100) for the new-skater welcome discount and the repeat-customer standing
# discount; REWARD_CODE_EXPIRES_DAYS is how long an issued code stays valid.
# Every reward path no-ops when NOTION_CLIENT_CRM_DATABASE_ID or Stripe is unset.
# See CLAUDE.md, "Referral & returning-skater rewards".
# REFERRAL_CREDIT_AMOUNT=40
# REFERRAL_WELCOME_PERCENT=10
# RETURNING_DISCOUNT_PERCENT=10
# REWARD_CODE_EXPIRES_DAYS=90

# Optional. FRONTEND BUILD-TIME. The customer-facing half of the rush-order
# surcharge: VITE_RUSH_WINDOW_DAYS is how many days out a needed-by date must be
# to count as a rush (default 21), and VITE_RUSH_SURCHARGE_NOTE is the exact
# disclosure copy shown on the order form (default "a 15% rush surcharge").
# Keep the note in step with the server's RUSH_SURCHARGE_RATE (also 15% by
# default) — the frontend only discloses the fee, the invoice line-item generator
# prices it. Read at build time by web-app/src/lib/rush.ts, so a change needs a
# redeploy. See CLAUDE.md, "Rush order surcharge".
# VITE_RUSH_WINDOW_DAYS=21
# VITE_RUSH_SURCHARGE_NOTE=a 15% rush surcharge
